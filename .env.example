# Sepolia RPC URL - dobija se sa Alchemy ili Infura (besplatno)
# https://www.alchemy.com/ -> kreiraj app -> kopiraj HTTPS URL
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key tvog MetaMask wallet-a za Sepolia
# MetaMask -> Account Details -> Export Private Key
# NIKAD ne koristiti mainnet wallet! Napravi poseban za development!
PRIVATE_KEY=0xyour_private_key_here

# Etherscan API key - za verifikaciju kontrakta (opciono)
# https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key
